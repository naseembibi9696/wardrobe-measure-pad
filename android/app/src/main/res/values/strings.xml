    <string name="guide_description">Measurement guide for %1$s. Follow the written instructions below.</string>
    <string name="guide_note">Keep the tape level and comfortably against the surface. Record what you actually measure.</string>
    <string name="guide_chest_1">Place the tape around the fullest part of the chest.</string>
    <string name="guide_chest_2">Keep the tape level across the back without compressing.</string>
    <string name="guide_chest_3">Breathe normally and read the full circumference.</string>
    <string name="guide_waist_1">Find the natural waist crease by bending gently to one side.</string>
    <string name="guide_waist_2">Wrap the tape level around that point, without pulling tight.</string>
    <string name="guide_waist_3">Relax and read the full circumference.</string>
    <string name="guide_hips_1">Stand with feet together and find the fullest part of the hips.</string>
    <string name="guide_hips_2">Wrap the tape around that point and check it stays level.</string>
    <string name="guide_hips_3">Read the full circumference without compressing clothing.</string>
    <string name="guide_inseam_1">Locate the crotch seam position and your desired hem.</string>
    <string name="guide_inseam_2">Measure down the inside leg. Use a helper if easier.</string>
    <string name="guide_inseam_3">Read the length, or use the inside seam of a well-fitting garment.</string>
    <string name="guide_height_1">Stand straight against a wall without shoes.</string>
    <string name="guide_height_2">Place a level book on the head and mark its height.</string>
    <string name="guide_height_3">Measure vertically from the floor to the mark.</string>
    <string name="guide_shoulder_1">Locate the outer shoulder points on both sides.</string>
    <string name="guide_shoulder_2">Keep shoulders relaxed and measure across the back.</string>
    <string name="guide_shoulder_3">Read the direct distance between those points.</string>
    <string name="guide_sleeve_1">Locate the shoulder point and bend the arm slightly.</string>
    <string name="guide_sleeve_2">Run the tape along the outer arm to the wrist.</string>
    <string name="guide_sleeve_3">Read the length while keeping the arm relaxed.</string>
    <string name="guide_neck_1">Wrap the tape around the base of the neck.</string>
    <string name="guide_neck_2">Keep it comfortably against the skin without compressing.</string>
    <string name="guide_neck_3">Read the full circumference while breathing normally.</string>
    <string name="guide_flat_1">Lay the garment flat and smooth it without stretching.</string>
    <string name="guide_flat_2">Measure straight across at the %1$s position.</string>
    <string name="guide_flat_3">Record the flat width. The app doubles it once for circumference comparisons.</string>
    <string name="guide_garment_inseam_1">Lay the trousers flat and smooth the inside-leg seam.</string>
    <string name="guide_garment_inseam_2">Measure along that seam from crotch to hem.</string>
    <string name="guide_garment_inseam_3">Record the direct seam length without doubling.</string>
    <string name="guide_garment_shoulder_1">Lay the shirt flat with its back facing up.</string>
    <string name="guide_garment_shoulder_2">Measure from one shoulder seam to the other.</string>
    <string name="guide_garment_shoulder_3">Record the direct width without doubling.</string>
    <string name="guide_garment_sleeve_1">Lay the sleeve flat and smooth it without stretching.</string>
    <string name="guide_garment_sleeve_2">Follow the outer sleeve from shoulder seam to cuff.</string>
    <string name="guide_garment_sleeve_3">Record the direct seam length without doubling.</string>
